# Copy this file to .env and replace the placeholder values.
# .env is ignored by git; never commit real credentials.

# MySQL credentials used by the mysql container and by the backend
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=hortifruti
MYSQL_USER=frutihorti
MYSQL_PASSWORD=change-me-app-password

# Host port mapped to MySQL (container port 3306)
MYSQL_HOST_PORT=3307
